    // One SKU row per colour/size combination. Typed values survive when sizes or colours change.
    function mountVariantTable(initialVariants, initialExcluded = []){
      const container = document.getElementById('p_variants');
      const draft = new Map((initialVariants||[]).map((v) => [`${String(v.size).trim().toLowerCase()}|${String(v.colour).split('|')[0].trim().toLowerCase()}`, { sku: v.sku || '', printTypeId: v.printTypeId, productSku: v.productSku || '', designSku: v.designSku || '', qikinkPrice: String(v.qikinkPrice ?? '') }]));
      const excluded = new Set(initialExcluded.map((v) => `${String(v.size).trim().toLowerCase()}|${String(v.colour).split('|')[0].trim().toLowerCase()}`));
      const snapshot = () => {
        container.querySelectorAll('tr[data-key]').forEach((row) => {
          const previous = draft.get(row.dataset.key) || {};
          draft.set(row.dataset.key, { ...previous, sku: row.querySelector('.v_sku').value.trim(), productSku: row.querySelector('.v_product_sku').value.trim(), designSku: row.querySelector('.v_design_sku').value.trim(), qikinkPrice: row.querySelector('.v_price').value });
        });
      };
      const render = () => {
        snapshot();
        const sizes = csvList(document.getElementById('p_sizes').value);
        const colours = csvList(document.getElementById('p_colours').value);
        if (!sizes.length || !colours.length) {
          container.innerHTML = '<div class="small muted">No rows yet. Enter at least one size and one colour above.</div>';
          return;
        }
        const rows = [];
        const removed = [];
        colours.forEach((colourOption) => sizes.forEach((size) => {
          const colour = colourOption.split('|')[0].trim();
          const key = `${size.toLowerCase()}|${colour.toLowerCase()}`;
          if (excluded.has(key)) {
            removed.push(`<button type="button" class="btn v_restore" data-key="${escapeHtml(key)}">Restore ${escapeHtml(colour)} / ${escapeHtml(size)}</button>`);
            return;
          }
          const d = draft.get(key) || { sku: '', productSku: '', designSku: '', qikinkPrice: '' };
          rows.push(`<tr data-key="${escapeHtml(key)}" data-size="${escapeHtml(size)}" data-colour="${escapeHtml(colour)}">
            <td>${escapeHtml(colour)}</td><td>${escapeHtml(size)}</td>
            <td><input class="v_sku" maxlength="50" value="${escapeHtml(d.sku)}" placeholder="Store SKU" aria-label="Store SKU for ${escapeHtml(colour)} ${escapeHtml(size)}" /></td>
            <td><input class="v_product_sku" maxlength="100" value="${escapeHtml(d.productSku)}" placeholder="Product SKU" aria-label="Product SKU for ${escapeHtml(colour)} ${escapeHtml(size)}" /></td>
            <td><input class="v_design_sku" maxlength="100" value="${escapeHtml(d.designSku)}" placeholder="Design SKU" aria-label="Design SKU for ${escapeHtml(colour)} ${escapeHtml(size)}" /></td>
            <td><input class="v_price" type="number" min="0.01" max="100000" step="0.01" value="${escapeHtml(d.qikinkPrice)}" placeholder="e.g. 305.48" aria-label="Product cost for ${escapeHtml(colour)} ${escapeHtml(size)}" /></td>
            <td><button type="button" class="btn danger v_remove" aria-label="Remove ${escapeHtml(colour)} ${escapeHtml(size)}">Remove</button></td>
          </tr>`);
        }));
        container.innerHTML = `<div style="overflow-x:auto"><table><thead><tr><th>Colour</th><th>Size</th><th>Store SKU</th><th>Product SKU</th><th>Design SKU</th><th>Product cost (₹)</th><th>Action</th></tr></thead><tbody>${rows.join('')}</tbody></table></div>${removed.length ? `<div class="small muted" style="margin-top:8px">Removed variations: ${removed.join(' ')}</div>` : ''}`;
      };
      document.getElementById('p_sizes').addEventListener('input', render);
      document.getElementById('p_colours').addEventListener('input', render);
      container.addEventListener('click', (event) => {
        const remove = event.target.closest('.v_remove');
        const restore = event.target.closest('.v_restore');
        if (remove) {
          snapshot();
          excluded.add(remove.closest('tr').dataset.key);
          render();
        } else if (restore) {
          excluded.delete(restore.dataset.key);
          render();
        }
      });
      document.getElementById('p_add_size').addEventListener('click', () => {
        const newSize = document.getElementById('p_new_size');
        const message = document.getElementById('p_size_message');
        const sizesInput = document.getElementById('p_sizes');
        const value = newSize.value.trim();
        const sizes = csvList(sizesInput.value);
        if (!value || value.includes(',')) {
          message.textContent = 'Enter one size at a time.';
          return;
        }
        if (sizes.some((size) => size.toLowerCase() === value.toLowerCase())) {
          message.textContent = 'This size is already in the list.';
          return;
        }
        if (sizes.length >= 50) {
          message.textContent = 'A product can have at most 50 sizes.';
          return;
        }
        sizesInput.value = [...sizes, value].join(', ');
        render();
        newSize.value = '';
        message.textContent = `Added size ${value}.`;
      });
      render();
      const collect = () => [...container.querySelectorAll('tr[data-key]')].flatMap((row) => {
        const sku = row.querySelector('.v_sku').value.trim();
        const productSku = row.querySelector('.v_product_sku').value.trim();
        const designSku = row.querySelector('.v_design_sku').value.trim();
        const printTypeId = (draft.get(row.dataset.key) || {}).printTypeId;
        const priceInput = row.querySelector('.v_price');
        const qikinkPrice = priceInput.value;
        if (!sku && !productSku && !designSku && !qikinkPrice && priceInput.validity.valid) return [];
        if (!sku) throw new Error(`Enter the Store SKU for ${row.dataset.colour} / ${row.dataset.size}.`);
        if (!priceInput.validity.valid || (qikinkPrice && (!Number.isFinite(Number(qikinkPrice)) || Number(qikinkPrice) < 0.01 || Number(qikinkPrice) > 100000))) {
          throw new Error(`Enter a valid Qikink price between 0.01 and 100000 for ${row.dataset.colour} / ${row.dataset.size}.`);
        }
        return [{ size: row.dataset.size, colour: row.dataset.colour, sku, ...(printTypeId === undefined ? {} : { printTypeId }), ...(productSku ? { productSku } : {}), ...(designSku ? { designSku } : {}), ...(qikinkPrice ? { qikinkPrice: Number(qikinkPrice) } : {}) }];
      });
      collect.excluded = () => csvList(document.getElementById('p_colours').value).flatMap((colourOption) => csvList(document.getElementById('p_sizes').value).flatMap((size) => {
        const colour = colourOption.split('|')[0].trim();
        return excluded.has(`${size.toLowerCase()}|${colour.toLowerCase()}`) ? [{ size, colour }] : [];
      }));
      return collect;
    }

