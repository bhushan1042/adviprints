    // Products list
    async function renderProductsList(){
      pageTitle.textContent = 'Products';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      // fetch categories and products
      const [catsRes, prodRes] = await Promise.all([api('/categories', { auth:false }), api('/products', { auth:false })]);
      const categories = catsRes.ok ? catsRes.body : [];
      if (!prodRes.ok) { content.innerHTML = '<div class="panel">Failed to load products</div>'; return; }
      let products = prodRes.body;

      function renderTableRows(list){
        return list.map(p => `<tr><td>${escapeHtml(p.name)}</td><td class="muted">${escapeHtml(p.category||'')}</td><td>$${Number(p.price||0).toFixed(2)}</td><td>${p.stock||0}</td><td class="actions"><button data-id="${p._id}" class="btn" data-action="edit-prod">Edit</button><button data-id="${p._id}" class="btn danger" data-action="delete-prod">Delete</button></td></tr>`).join('');
      }

      let html = '<div class="panel"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">'
        + '<h3>Products</h3>'
        + '<div style="display:flex;gap:8px;align-items:center">'
          + '<select id="filter_cat"><option value="">All categories</option>' + categories.map(c=>`<option value="${c._id}">${escapeHtml(c.name)}</option>`).join('') + '</select>'
          + '<button class="btn primary" id="addProdBtn">Add</button>'
        + '</div>'
      + '</div>';
      html += '<table><thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Actions</th></tr></thead><tbody id="products_tbody">';
      html += renderTableRows(products);
      html += '</tbody></table></div>';
      content.innerHTML = html;

      document.getElementById('addProdBtn').addEventListener('click', ()=> navigate('/admin/products/add'));

      // edit/delete handlers
      function attachRowHandlers(){
        content.querySelectorAll('[data-action="edit-prod"]').forEach(b=> b.addEventListener('click', e=>{
          navigate('/admin/products/' + e.target.getAttribute('data-id') + '/edit');
        }));
        content.querySelectorAll('[data-action="delete-prod"]').forEach(b=> b.addEventListener('click', async (e)=>{
          const id = e.target.getAttribute('data-id');
          if (!confirm('Delete product?')) return;
          const res = await api('/products/' + id, { method:'DELETE' });
          if (!res.ok) return alert((res.body && res.body.error) || 'Failed');
          alert('Product deleted'); renderProductsList();
        }));
      }
      attachRowHandlers();

      // filter change: fetch products for a category or all
      const filter = document.getElementById('filter_cat');
      filter.addEventListener('change', async (e)=>{
        const cid = e.target.value;
        content.querySelector('#products_tbody').innerHTML = '<tr><td colspan="5">Loading...</td></tr>';
        try {
          let listRes;
          if (!cid) listRes = await api('/products', { auth:false });
          else listRes = await api('/categories/' + cid + '/products', { auth:false });
          if (!listRes.ok) { content.querySelector('#products_tbody').innerHTML = '<tr><td colspan="5">Failed to load</td></tr>'; return; }
          products = listRes.body;
          content.querySelector('#products_tbody').innerHTML = renderTableRows(products);
          attachRowHandlers();
        } catch (err) { content.querySelector('#products_tbody').innerHTML = '<tr><td colspan="5">Error</td></tr>'; }
      });
    }

