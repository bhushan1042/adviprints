<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Admin Panel</title>
  <style>
    :root{--bg:#f5f7fb;--primary:#2b6cb0;--panel:#fff;--muted:#666}
    body{margin:0;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:#222}
    .app{display:flex;height:100vh}
    .sidebar{width:220px;background:#1f2937;color:white;padding:18px;box-sizing:border-box}
    .sidebar h2{font-size:16;margin:0 0 12px}
    .nav{list-style:none;padding:0;margin:0}
    .nav li{margin:8px 0}
    .nav a{color:rgba(255,255,255,0.9);text-decoration:none;display:block;padding:8px;border-radius:4px}
    .nav a.active{background:rgba(255,255,255,0.08)}
    .main{flex:1;padding:20px;box-sizing:border-box;overflow:auto}
    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
    header h1{margin:0;font-size:18px}
    .panel{background:var(--panel);padding:16px;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.06)}
    .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:12px;margin-top:12px}
    .card{padding:12px;border-radius:6px;background:#fff;border:1px solid #eef2f7}
    table{width:100%;border-collapse:collapse}
    th,td{padding:8px;border-bottom:1px solid #eee;text-align:left}
    .actions button{margin-left:6px}
    .topbar{display:flex;align-items:center;gap:8px}
    .btn{padding:8px 10px;border:0;border-radius:6px;cursor:pointer}
    .btn.primary{background:var(--primary);color:white}
    .btn.danger{background:#e53e3e;color:white}
    .form-row{display:flex;gap:8px;flex-wrap:wrap}
    .form-row > *{flex:1;min-width:120px}
    input,select,textarea{padding:8px;border:1px solid #d1d5db;border-radius:6px;width:100%;box-sizing:border-box}
    .muted{color:var(--muted);font-size:13px}
    .small{font-size:13px}
  </style>
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <h2>Admin</h2>
      <ul class="nav" id="sidebarNav">
        <li><a href="/admin/dashboard" data-route="dashboard">Dashboard</a></li>
        <li><a href="/admin/homepage" data-route="homepage">Homepage</a></li>
        <li><a href="/admin/user-list" data-route="users">Users</a></li>
        <li><a href="/admin/categories-list" data-route="categories">Categories</a></li>
        <li><a href="/admin/products-list" data-route="products">Products</a></li>
        <li><a href="/admin/branding" data-route="branding">Branding</a></li>
        <li><a href="/admin/orders" data-route="orders">Orders</a></li>
      </ul>
      <div style="margin-top:18px">
        <button id="logoutBtn" class="btn">Logout</button>
      </div>
    </aside>

    <main class="main">
      <header>
        <h1 id="pageTitle">Dashboard</h1>
        <div class="topbar"><div id="userInfo" class="muted"></div></div>
      </header>

      <div id="content"></div>
    </main>
  </div>

  <script>
    // Simple client-side router for admin SPA
    const tokenKey = 'admin_token';
    const token = localStorage.getItem(tokenKey);
    if (!token) window.location.href = '/login';

    const authHeader = () => ({ 'Authorization': 'Bearer ' + localStorage.getItem(tokenKey) });

    // Utility API wrapper
    async function api(path, options = {}) {
      const headers = options.headers || {};
      if (options.auth !== false) Object.assign(headers, authHeader());
      if (options.body && !(options.body instanceof FormData)) headers['Content-Type'] = 'application/json';
      const res = await fetch(path, { ...options, headers });
      const text = await res.text();
      try { return { ok: res.ok, status: res.status, body: JSON.parse(text) } } catch { return { ok: res.ok, status: res.status, body: text } }
    }

    // Download protected file using fetch + Authorization header
    async function downloadProtectedFile(orderId, type) {
      const token = localStorage.getItem(tokenKey);
      if (!token) { alert('Not authenticated'); return; }
      try {
        const resp = await fetch(`/api/orders/${orderId}/download/${type}`, {
          method: 'GET',
          headers: { 'Authorization': 'Bearer ' + token }
        });

          if (!resp.ok) {
            // attempt to parse JSON error
            let jsonErr = null;
            try { jsonErr = await resp.json(); } catch (e) { }
            const msg = (jsonErr && (jsonErr.error || jsonErr.message)) || `Download failed (status ${resp.status})`;
            alert(msg);
            return;
          }

        // get filename from Content-Disposition header if present
        const disposition = resp.headers.get('Content-Disposition') || resp.headers.get('content-disposition') || '';
        let filename = '';
        const match = disposition.match(/filename\*?=(?:UTF-8''?)?"?([^";\n]+)/i);
        if (match && match[1]) {
          filename = decodeURIComponent(match[1].replace(/"/g, ''));
        }

        // fallback to path-based filename
        if (!filename) {
          try {
            const urlParts = resp.url.split('/');
            filename = urlParts[urlParts.length - 1] || `${type}_${orderId}`;
          } catch (e) {
            filename = `${type}_${orderId}`;
          }
        }

        const blob = await resp.blob();
        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(blobUrl);
      } catch (err) {
        console.error('Download error', err);
        alert('Download failed: ' + (err.message || err));
      }
    }

    // Router
    function navigate(path, replace=false) {
      if (replace) history.replaceState(null, '', path); else history.pushState(null, '', path);
      renderRoute();
    }
    window.addEventListener('popstate', renderRoute);

    const content = document.getElementById('content');
    const pageTitle = document.getElementById('pageTitle');
    const sidebarNav = document.getElementById('sidebarNav');

    sidebarNav.addEventListener('click', (e) => {
      const a = e.target.closest('a');
      if (!a) return;
      e.preventDefault();
      const route = a.getAttribute('data-route');
      if (route === 'dashboard') navigate('/admin/dashboard');
      else if (route === 'homepage') navigate('/admin/homepage');
      else if (route === 'users') navigate('/admin/user-list');
      else if (route === 'categories') navigate('/admin/categories-list');
      else if (route === 'products') navigate('/admin/products-list');
      else if (route === 'branding') navigate('/admin/branding');
      else if (route === 'orders') navigate('/admin/orders');
    });

    document.getElementById('logoutBtn').addEventListener('click', () => { localStorage.removeItem(tokenKey); window.location.href = '/login'; });

    // Route rendering
    async function renderRoute() {
      const path = location.pathname.replace(/\/+$|^\/+/g, '').split('/').slice(1).join('/');
      // path like 'admin/dashboard' or 'admin/categories/123/edit'
      const parts = location.pathname.split('/').filter(Boolean).slice(1); // after admin
      const route = parts[0] || 'dashboard';
      // highlight sidebar
      Array.from(sidebarNav.querySelectorAll('a')).forEach(a => a.classList.toggle('active', a.getAttribute('data-route') === route));

      if (route === 'dashboard') await renderDashboard();
      else if (route === 'user-list') await renderUsersList();
      else if (route === 'users' && parts[1] && parts[2] === 'edit') await renderUserEdit(parts[1]);
      else if (route === 'homepage') await renderHomepage();
      else if (route === 'branding') await renderBranding();
      else if (route === 'categories-list') await renderCategoriesList();
      else if (route === 'categories' && parts[1] === 'add') await renderCategoryAdd();
      else if (route === 'categories' && parts[2] === 'edit') await renderCategoryEdit(parts[1]);
      else if (route === 'products-list') await renderProductsList();
      else if (route === 'products' && parts[1] === 'add') await renderProductAdd();
      else if (route === 'products' && parts[2] === 'edit') await renderProductEdit(parts[1]);
      else if (route === 'orders') await renderOrders();
      else await renderDashboard();
    }

    // Branding management
    async function renderBranding(){
      pageTitle.textContent = 'Branding Settings';
      content.innerHTML = `
        <div class="panel">
          <h3>Branding Settings</h3>
          <p class="muted">Upload site logos (SVG, PNG, JPG, WEBP). Max 10MB.</p>
          <div class="grid">
            <div class="card">
              <label>Main Logo (desktop)</label>
              <input id="mainLogo_file" type="file" accept="image/*" />
              <input id="mainLogo_url" type="hidden" />
              <div class="small muted">Recommended: 220×60px PNG (transparent background) for desktop header.</div>
              <div style="margin-top:8px"><img id="mainLogo_preview" src="" style="max-width:220px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            </div>
            <div class="card">
              <label>Mobile Logo</label>
              <input id="mobileLogo_file" type="file" accept="image/*" />
              <input id="mobileLogo_url" type="hidden" />
              <div style="margin-top:8px"><img id="mobileLogo_preview" src="" style="max-width:120px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            </div>
            <div class="card">
              <label>Favicon</label>
              <input id="favicon_file" type="file" accept="image/*" />
              <input id="favicon_url" type="hidden" />
              <div style="margin-top:8px"><img id="favicon_preview" src="" style="max-width:64px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            </div>
            <div class="card">
              <label>Dark Theme Logo</label>
              <input id="darkLogo_file" type="file" accept="image/*" />
              <input id="darkLogo_url" type="hidden" />
              <div style="margin-top:8px"><img id="darkLogo_preview" src="" style="max-width:120px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            </div>
            <div class="card">
              <label>Light Theme Logo</label>
              <input id="lightLogo_file" type="file" accept="image/*" />
              <input id="lightLogo_url" type="hidden" />
              <div style="margin-top:8px"><img id="lightLogo_preview" src="" style="max-width:120px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            </div>
            <div class="card">
              <label>Email Logo</label>
              <input id="emailLogo_file" type="file" accept="image/*" />
              <input id="emailLogo_url" type="hidden" />
              <div style="margin-top:8px"><img id="emailLogo_preview" src="" style="max-width:220px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            </div>
            <div class="card">
              <label>Footer Logo</label>
              <input id="footerLogo_file" type="file" accept="image/*" />
              <input id="footerLogo_url" type="hidden" />
              <div class="small muted">Recommended: 280×60px PNG (transparent background). This logo is used in the site footer.</div>
              <div style="margin-top:8px"><img id="footerLogo_preview" src="" style="max-width:280px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            </div>
          </div>
          <div style="margin-top:12px"><button id="brandingSave" class="btn primary">Save Branding</button></div>
          <div id="branding_msg" class="muted" style="margin-top:8px"></div>
        </div>
      `;

      // load existing
      const bres = await api('/api/branding', { auth:false });
      if (bres.ok && bres.body) {
        const b = bres.body;
        const make = (id, url) => { if (!url) return; const el = document.getElementById(id + '_preview'); el.src = url; el.style.display = 'block'; document.getElementById(id + '_url').value = url; };
        make('mainLogo', b.mainLogo);
        make('footerLogo', b.footerLogo);
        make('mobileLogo', b.mobileLogo);
        make('favicon', b.favicon);
        make('darkLogo', b.darkLogo);
        make('lightLogo', b.lightLogo);
        make('emailLogo', b.emailLogo);
      }

      // Save handler
      document.getElementById('brandingSave').addEventListener('click', async ()=>{
        document.getElementById('branding_msg').textContent = 'Saving...';
        const fd = new FormData();
        ['mainLogo','footerLogo','mobileLogo','favicon','darkLogo','lightLogo','emailLogo'].forEach(k=>{
          const f = document.getElementById(k + '_file').files[0];
          if (f) fd.append(k, f);
          else {
            const existing = document.getElementById(k + '_url').value;
            if (existing) fd.append(k, existing);
          }
        });
        try {
          const resp = await fetch('/api/admin/branding', { method:'POST', headers: { 'Authorization': 'Bearer ' + localStorage.getItem(tokenKey) }, body: fd });
          const json = await resp.json();
          if (!resp.ok) { document.getElementById('branding_msg').textContent = (json && json.error) || 'Save failed'; return; }
          document.getElementById('branding_msg').textContent = 'Saved successfully';
          // update previews
          const b = json.branding || {};
          if (b.mainLogo) { document.getElementById('mainLogo_preview').src = b.mainLogo; document.getElementById('mainLogo_preview').style.display='block'; }
          if (b.footerLogo) { document.getElementById('footerLogo_preview').src = b.footerLogo; document.getElementById('footerLogo_preview').style.display='block'; }
          if (b.mobileLogo) { document.getElementById('mobileLogo_preview').src = b.mobileLogo; document.getElementById('mobileLogo_preview').style.display='block'; }
          if (b.favicon) { document.getElementById('favicon_preview').src = b.favicon; document.getElementById('favicon_preview').style.display='block'; }
          if (b.darkLogo) { document.getElementById('darkLogo_preview').src = b.darkLogo; document.getElementById('darkLogo_preview').style.display='block'; }
          if (b.lightLogo) { document.getElementById('lightLogo_preview').src = b.lightLogo; document.getElementById('lightLogo_preview').style.display='block'; }
          if (b.emailLogo) { document.getElementById('emailLogo_preview').src = b.emailLogo; document.getElementById('emailLogo_preview').style.display='block'; }
        } catch (err) {
          console.error(err);
          document.getElementById('branding_msg').textContent = 'Save failed';
        }
      });
    }

    // Dashboard
    async function renderDashboard() {
      pageTitle.textContent = 'Dashboard';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      const res = await api('/admin/stats');
      if (!res.ok) { content.innerHTML = '<div class="panel">Failed to load stats</div>'; return; }
      const s = res.body;
      content.innerHTML = `
        <div class="panel">
          <h3>Overview</h3>
          <div class="grid">
            <div class="card"><strong>${s.users}</strong><div class="small">Users</div></div>
            <div class="card"><strong>${s.categories}</strong><div class="small">Categories</div></div>
            <div class="card"><strong>${s.products}</strong><div class="small">Products</div></div>
          </div>
        </div>
      `;
    }

    // Users list
    async function renderUsersList() {
      pageTitle.textContent = 'Users';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      const res = await api('/users');
      if (!res.ok) { content.innerHTML = '<div class="panel">Failed to load users</div>'; return; }
      const users = res.body;
      let html = '<div class="panel"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"><h3>Users</h3><div><button class="btn primary" id="addUserBtn">Add</button></div></div>';
      html += '<table><thead><tr><th>Name</th><th>Email</th><th>Created</th><th>Actions</th></tr></thead><tbody>';
      users.forEach(u => {
        html += `<tr><td>${escapeHtml(u.name||'')}</td><td>${escapeHtml(u.email||'')}</td><td class="muted">${new Date(u.createdAt||u._id?parseInt(u._id.substring(0,8),16)*1000:Date.now()).toLocaleString()}</td><td class="actions"><button data-id="${u._id}" class="btn" data-action="edit-user">Edit</button><button data-id="${u._id}" class="btn danger" data-action="delete-user">Delete</button></td></tr>`;
      });
      html += '</tbody></table></div>';
      content.innerHTML = html;
      document.getElementById('addUserBtn').addEventListener('click', () => navigate('/admin/users/add'));
      content.querySelectorAll('[data-action="edit-user"]').forEach(b => b.addEventListener('click', (e)=>{
        const id = e.target.getAttribute('data-id'); navigate('/admin/users/' + id + '/edit');
      }));
      content.querySelectorAll('[data-action="delete-user"]').forEach(b => b.addEventListener('click', async (e)=>{
        const id = e.target.getAttribute('data-id');
        if (!confirm('Delete user?')) return;
        const res = await api('/users/' + id, { method:'DELETE' });
        if (!res.ok) return alert((res.body && res.body.error) || 'Failed');
        alert('User deleted'); renderUsersList();
      }));
    }

    // Category list
    async function renderCategoriesList(){
      pageTitle.textContent = 'Categories';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      const res = await api('/categories', { auth:false });
      if (!res.ok) { content.innerHTML = '<div class="panel">Failed to load categories</div>'; return; }
      const cats = res.body;
      let html = '<div class="panel"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"><h3>Categories</h3><div><button class="btn primary" id="addCatBtn">Add</button></div></div>';
      html += '<table><thead><tr><th>Name</th><th>Description</th><th>Actions</th></tr></thead><tbody>';
      cats.forEach(c => {
        html += `<tr><td>${escapeHtml(c.name)}</td><td>${escapeHtml(c.description||'')}</td><td class="actions"><button data-id="${c._id}" class="btn" data-action="edit-cat">Edit</button><button data-id="${c._id}" class="btn danger" data-action="delete-cat">Delete</button></td></tr>`;
      });
      html += '</tbody></table></div>';
      content.innerHTML = html;
      document.getElementById('addCatBtn').addEventListener('click', ()=> navigate('/admin/categories/add'));
      content.querySelectorAll('[data-action="edit-cat"]').forEach(b=> b.addEventListener('click', e=>{
        navigate('/admin/categories/' + e.target.getAttribute('data-id') + '/edit');
      }));
      content.querySelectorAll('[data-action="delete-cat"]').forEach(b=> b.addEventListener('click', async (e)=>{
        const id = e.target.getAttribute('data-id');
        if (!confirm('Delete category?')) return;
        const res = await api('/categories/' + id, { method:'DELETE' });
        if (!res.ok) return alert((res.body && res.body.error) || 'Failed');
        alert('Category deleted'); renderCategoriesList();
      }));
    }

    // Category Add/Edit
    async function renderCategoryAdd(){
      pageTitle.textContent = 'Add Category';
      content.innerHTML = `
        <div class="panel">
          <h3>Add Category</h3>
          <div class="form-row">
            <div>
              <label for="c_name">Name</label>
              <input id="c_name" placeholder="e.g. Visiting Cards" />
              <div class="small muted">A short, human-readable category name shown to customers.</div>
            </div>
            <div>
              <label for="c_desc">Description</label>
              <input id="c_desc" placeholder="Optional: short description" />
              <div class="small muted">Optional longer description to explain the category.</div>
            </div>
          </div>
          <div style="margin-top:8px">
            <label for="c_image_file">Category Image (homepage slider)</label>
            <input id="c_image_file" type="file" accept="image/*" />
            <div class="small muted">This image appears on the homepage slider.</div>
            <div style="margin-top:8px"><img id="c_image_preview" src="" style="max-width:160px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            <input type="hidden" id="c_imageUrl" />
          </div>
          <div style="margin-top:8px">
            <label for="c_banner_file">Category Banner Image (category page)</label>
            <input id="c_banner_file" type="file" accept="image/*" />
            <div class="small muted">This image is used in the category detail banner.</div>
            <div style="margin-top:8px"><img id="c_banner_preview" src="" style="max-width:220px;display:none;border-radius:6px;border:1px solid #eee"/></div>
            <input type="hidden" id="c_bannerUrl" />
          </div>
          <div style="margin-top:12px"><button class="btn primary" id="saveCatBtn">Save</button> <button class="btn" id="cancelCatBtn">Cancel</button></div>
          <div id="c_err" class="muted"></div>
        </div>`;

      // add showcase inputs for new category
      const showcaseHtml = `
        <div style="margin-top:12px">
          <h4>Homepage Showcase</h4>
          <div class="form-row">
            <div>
              <label for="c_showcase_title">Showcase Title</label>
              <input id="c_showcase_title" placeholder="Optional: override showcase title" />
            </div>
            <div>
              <label for="c_showcase_cta">CTA Text</label>
              <input id="c_showcase_cta" placeholder="Button text (e.g. Design Your T-Shirt)" />
            </div>
          </div>
          <div style="margin-top:8px">
            <label for="c_showcase_sub">Showcase Subtitle</label>
            <input id="c_showcase_sub" placeholder="Short descriptive subtitle" />
          </div>
          <div style="margin-top:8px">
            <label for="c_showcase_features">Showcase Features (one per line)</label>
            <textarea id="c_showcase_features" placeholder="One feature per line" style="min-height:80px"></textarea>
            <div class="small muted">These appear as bulleted features in the showcase.</div>
          </div>
        </div>`;
      document.getElementById('content').querySelector('.panel').insertAdjacentHTML('beforeend', showcaseHtml);
      document.getElementById('cancelCatBtn').addEventListener('click', ()=> navigate('/admin/categories-list'));
      // upload handlers
      document.getElementById('c_image_file').addEventListener('change', async (e)=>{
        const f = e.target.files[0]; if (!f) return;
        const fd = new FormData(); fd.append('image', f);
        const token = localStorage.getItem(tokenKey);
        const r = await fetch('/upload', { method:'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
        const data = await r.json(); if (!r.ok) { document.getElementById('c_err').textContent = (data && data.error) || 'Upload failed'; return; }
        document.getElementById('c_imageUrl').value = data.url; document.getElementById('c_image_preview').src = data.url; document.getElementById('c_image_preview').style.display = 'block';
      });
      document.getElementById('c_banner_file').addEventListener('change', async (e)=>{
        const f = e.target.files[0]; if (!f) return;
        const fd = new FormData(); fd.append('image', f);
        const token = localStorage.getItem(tokenKey);
        const r = await fetch('/upload', { method:'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
        const data = await r.json(); if (!r.ok) { document.getElementById('c_err').textContent = (data && data.error) || 'Upload failed'; return; }
        document.getElementById('c_bannerUrl').value = data.url; document.getElementById('c_banner_preview').src = data.url; document.getElementById('c_banner_preview').style.display = 'block';
      });

      document.getElementById('saveCatBtn').addEventListener('click', async ()=>{
        const name = document.getElementById('c_name').value.trim();
        const description = document.getElementById('c_desc').value.trim();
        const imageUrl = document.getElementById('c_imageUrl').value || undefined;
        const bannerImageUrl = document.getElementById('c_bannerUrl').value || undefined;
        const showcaseTitle = (document.getElementById('c_showcase_title') && document.getElementById('c_showcase_title').value.trim()) || undefined;
        const showcaseSubtitle = (document.getElementById('c_showcase_sub') && document.getElementById('c_showcase_sub').value.trim()) || undefined;
        const showcaseFeatures = (document.getElementById('c_showcase_features') && document.getElementById('c_showcase_features').value) || undefined;
        const showcaseCtaText = (document.getElementById('c_showcase_cta') && document.getElementById('c_showcase_cta').value.trim()) || undefined;
        if (!name) return document.getElementById('c_err').textContent = 'Name required';
        const res = await api('/categories', { method:'POST', body: JSON.stringify({ name, description, imageUrl, bannerImageUrl, showcaseTitle, showcaseSubtitle, showcaseFeatures, showcaseCtaText }) });
        if (!res.ok) return document.getElementById('c_err').textContent = (res.body && res.body.error) || 'Failed';
        alert('Category added'); navigate('/admin/categories-list');
      });
    }

    async function renderCategoryEdit(id){
      pageTitle.textContent = 'Edit Category';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      const res = await api('/categories/' + id);
      if (!res.ok) { content.innerHTML = '<div class="panel">Category not found</div>'; return; }
      const c = res.body;
