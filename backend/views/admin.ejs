    function bindProductImageUpload(){
      const inputs = [
        { file: 'p_image_file', preview: 'p_image_preview', url: 'p_imageUrl', metadata: true },
        { file: 'p_thumbnail_file', preview: 'p_thumbnail_preview', url: 'p_thumbnailUrl', metadata: false }
      ];
      let pending = 0;
      const failures = new Set();
      const errorElement = document.getElementById('p_err');
      const updateUploadMessage = () => {
        if (failures.size) errorElement.textContent = 'An image upload failed. Please select the image again before saving.';
        else if (pending) errorElement.textContent = 'Uploading image...';
        else errorElement.textContent = '';
      };
      inputs.forEach((input) => {
        let sequence = 0;
        const fileInput = document.getElementById(input.file);
        const preview = document.getElementById(input.preview);
        const urlInput = document.getElementById(input.url);
        const filenameInput = document.getElementById('p_imageFilename');
        const mimeInput = document.getElementById('p_imageMime');
        const sizeInput = document.getElementById('p_imageSize');
        fileInput.addEventListener('change', async (e) => {
          const file = e.target.files[0];
          if (!file) return;
          const current = ++sequence;
          pending += 1;
          failures.delete(input.file);
          updateUploadMessage();
          try {
            const fd = new FormData(); fd.append('image', file); fd.append('folder', 'products');
            const token = localStorage.getItem(tokenKey);
            const res = await fetch('/upload', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
            const data = await res.json();
            if (!res.ok || !data.url) throw new Error((data && data.error) || 'Upload failed');
            if (current !== sequence) return;
            urlInput.value = data.url;
            preview.src = data.url;
            preview.style.display = 'block';
            if (input.metadata) {
              filenameInput.value = data.filename || '';
              mimeInput.value = data.mimetype || '';
              sizeInput.value = data.size || '';
            }
          } catch (err) {
            console.error(err);
            if (current === sequence) {
              failures.add(input.file);
            }
          } finally {
            pending -= 1;
            updateUploadMessage();
          }
        });
      });
      return () => {
        if (pending) throw new Error('Please wait for image uploads to finish.');
        if (failures.size) throw new Error('An image upload failed. Please select the image again before saving.');
      };
    }

    async function renderProductAdd(){
      pageTitle.textContent = 'Add Product';
      const catsRes = await api('/categories', { auth:false });
      const cats = catsRes.ok ? catsRes.body : [];
      content.innerHTML = `
