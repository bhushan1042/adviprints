    // Products list
    async function renderProductsList(){
      pageTitle.textContent = 'Products';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      // Admin needs to see every product, including products awaiting approval.
      const [catsRes, prodRes] = await Promise.all([api('/categories', { auth:false }), api('/products/admin/all')]);
      const categories = catsRes.ok ? catsRes.body : [];
      if (!prodRes.ok) { content.innerHTML = '<div class="panel">Failed to load products</div>'; return; }
      if (!Array.isArray(prodRes.body)) { content.innerHTML = '<div class="panel">Product list response was invalid. Please refresh and try again.</div>'; return; }
      const products = prodRes.body;

      function renderTableRows(list){
        if (!list.length) return '<tr><td colspan="5" class="muted">No products found.</td></tr>';
        return list.map(p => `<tr><td>${escapeHtml(p.name)}</td><td class="muted">${escapeHtml(p.category||'')}</td><td>$${Number(p.price||0).toFixed(2)}</td><td>${escapeHtml(p.status||'PENDING')}</td><td class="actions"><button data-id="${p._id}" class="btn" data-action="edit-prod">Edit</button><button data-id="${p._id}" class="btn danger" data-action="delete-prod">Delete</button></td></tr>`).join('');
      }

      let html = '<div class="panel"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">'
        + '<h3>Products</h3>'
        + '<div style="display:flex;gap:8px;align-items:center">'
          + '<select id="filter_cat"><option value="">All categories</option>' + categories.map(c=>`<option value="${c._id}">${escapeHtml(c.name)}</option>`).join('') + '</select>'
          + '<button class="btn primary" id="addProdBtn">Add</button>'
        + '</div>'
      + '</div>';
      html += '<table><thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Approval</th><th>Actions</th></tr></thead><tbody id="products_tbody">';
      html += renderTableRows(products);
      html += '</tbody></table></div>';
      content.innerHTML = html;

      document.getElementById('addProdBtn').addEventListener('click', ()=> navigate('/admin/products/add'));

      // edit/delete handlers
      function attachRowHandlers(){
        content.querySelectorAll('[data-action="edit-prod"]').forEach(b=> b.addEventListener('click', e=>{
          navigate('/admin/products/' + e.target.getAttribute('data-id') + '/edit');
        }));
        content.querySelectorAll('[data-action="delete-prod"]').forEach(b=> b.addEventListener('click', async (e)=>{
          const id = e.target.getAttribute('data-id');
          if (!confirm('Delete product?')) return;
          const res = await api('/products/' + id, { method:'DELETE' });
          if (!res.ok) return alert((res.body && res.body.error) || 'Failed');
          alert('Product deleted'); renderProductsList();
        }));
      }
      attachRowHandlers();

      // Filter the full admin list; public category endpoints intentionally hide PENDING products.
      const filter = document.getElementById('filter_cat');
      filter.addEventListener('change', async (e)=>{
        const cid = e.target.value;
        content.querySelector('#products_tbody').innerHTML = '<tr><td colspan="5">Loading...</td></tr>';
        const category = categories.find((item) => String(item._id) === cid);
        const filtered = !category ? products : products.filter((product) =>
          String(product.category || '') === String(category.name) ||
          String(product.category || '') === String(category._id) ||
          String(product.categoryId || '') === String(category._id)
        );
        content.querySelector('#products_tbody').innerHTML = renderTableRows(filtered);
        attachRowHandlers();
      });
    }

