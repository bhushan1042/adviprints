    // Homepage admin
    async function renderHomepage(){
      pageTitle.textContent = 'Homepage';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      const res = await api('/homepage');
      if (!res.ok) { content.innerHTML = '<div class="panel">Failed to load homepage</div>'; return; }
      const doc = res.body;

      // use bannerSlides if present, otherwise fallback to bannerImages
      const slides = (Array.isArray(doc.bannerSlides) && doc.bannerSlides.length) ? doc.bannerSlides.map(s=>Object.assign({}, s)) : (Array.isArray(doc.bannerImages) ? doc.bannerImages.map((u,i)=>({ imageUrl: u, caption:'', ctaText:'', ctaUrl:'', order:i })) : []);

      let html = `<div class="panel"><h3>Homepage Settings</h3>
        <div style="margin-top:8px"><label>Banner Title (optional)</label><input id="hp_title" value="${escapeHtml(doc.title||'')}" placeholder="Main headline for homepage" /></div>
        <div style="margin-top:8px"><label>Upload Banner Images</label><input id="hp_files" type="file" accept="image/*" multiple /></div>
        <div style="margin-top:8px"><div class="small muted">Drag to reorder slides. Edit caption and CTA for each slide. Remove to delete.</div></div>
        <div style="margin-top:12px" id="hp_slides_container"></div>
        <div style="margin-top:12px"><button class="btn primary" id="saveHpBtn">Save</button> <button class="btn" id="cancelHpBtn">Cancel</button></div>
        <div id="hp_err" class="muted"></div></div>`;
      content.innerHTML = html;

      const titleInput = document.getElementById('hp_title');
      const fileInput = document.getElementById('hp_files');
      const slidesContainer = document.getElementById('hp_slides_container');
      let slideList = slides.slice(); // local mutable list of slide objects {imageUrl, caption, ctaText, ctaUrl, order}

      function renderSlides(){
        slidesContainer.innerHTML = '';
        slideList.sort((a,b)=> (a.order||0) - (b.order||0));
        slideList.forEach((s, idx) => {
          const item = document.createElement('div');
          item.className = 'hp-slide-item panel';
          item.setAttribute('draggable', 'true');
          item.style.display = 'flex';
          item.style.gap = '12px';
          item.style.alignItems = 'center';
          item.style.marginBottom = '8px';
          item.dataset.index = idx;

          item.innerHTML = `
            <div style="width:140px;flex:0 0 140px">
              <img src="${escapeHtml(s.imageUrl||'')}" style="width:100%;height:80px;object-fit:cover;border-radius:6px;border:1px solid #eee" />
            </div>
            <div style="flex:1;display:flex;flex-direction:column;gap:6px">
              <input class="hp-caption" placeholder="Slide caption (optional)" value="${escapeHtml(s.caption||'')}" />
              <div style="display:flex;gap:8px">
                <input class="hp-ctaText" placeholder="CTA text (e.g. Shop now)" value="${escapeHtml(s.ctaText||'')}" />
                <input class="hp-ctaUrl" placeholder="CTA target URL (optional)" value="${escapeHtml(s.ctaUrl||'')}" />
              </div>
            </div>
            <div style="display:flex;flex-direction:column;gap:8px;align-items:flex-end">
              <button class="btn" data-action="remove" title="Remove">Remove</button>
              <div style="cursor:grab;padding:6px;color:#666" class="drag-handle">☰</div>
            </div>
          `;

          // input handlers
          item.querySelector('.hp-caption').addEventListener('input', (e)=> { slideList[idx].caption = e.target.value; });
          item.querySelector('.hp-ctaText').addEventListener('input', (e)=> { slideList[idx].ctaText = e.target.value; });
          item.querySelector('.hp-ctaUrl').addEventListener('input', (e)=> { slideList[idx].ctaUrl = e.target.value; });

          // remove
          item.querySelector('[data-action="remove"]').addEventListener('click', async ()=>{
            if (!confirm('Remove this slide?')) return;
            slideList.splice(idx,1);
            // reindex orders
            slideList.forEach((sl,i)=> sl.order = i);
            renderSlides();
          });

          // drag handlers
          item.addEventListener('dragstart', (ev)=>{
            ev.dataTransfer.setData('text/plain', idx.toString());
            ev.dataTransfer.effectAllowed = 'move';
            item.style.opacity = '0.6';
          });
          item.addEventListener('dragend', ()=>{ item.style.opacity = ''; });
          item.addEventListener('dragover', (ev)=>{ ev.preventDefault(); ev.dataTransfer.dropEffect = 'move'; });
          item.addEventListener('drop', (ev)=>{
            ev.preventDefault();
            const src = Number(ev.dataTransfer.getData('text/plain'));
            const dest = Number(item.dataset.index);
            if (isNaN(src) || isNaN(dest)) return;
            const moved = slideList.splice(src,1)[0];
            slideList.splice(dest,0,moved);
            slideList.forEach((sl,i)=> sl.order = i);
            renderSlides();
          });

          slidesContainer.appendChild(item);
        });

        if (slideList.length === 0) {
          slidesContainer.innerHTML = '<div class="muted">No slides. Upload images to add slides.</div>';
        }
      }

      renderSlides();

      // file upload handler: upload multiple and append slides
      fileInput.addEventListener('change', async (e)=>{
        const files = Array.from(e.target.files || []);
        if (!files.length) return;
        document.getElementById('hp_err').textContent = 'Uploading...';
        for (const f of files){
          const fd = new FormData(); fd.append('image', f);
          const token = localStorage.getItem(tokenKey);
          try {
            const r = await fetch('/upload', { method: 'POST', headers: { 'Authorization': 'Bearer ' + token }, body: fd });
            const data = await r.json();
            if (!r.ok) { document.getElementById('hp_err').textContent = (data && data.error) || 'Upload failed'; continue; }
            slideList.push({ imageUrl: data.url, caption: '', ctaText: '', ctaUrl: '', order: slideList.length });
            renderSlides();
          } catch(err){ console.error(err); document.getElementById('hp_err').textContent = 'Upload failed'; }
        }
        document.getElementById('hp_err').textContent = '';
        fileInput.value = '';
      });

      document.getElementById('cancelHpBtn').addEventListener('click', ()=> navigate('/admin/dashboard'));
      document.getElementById('saveHpBtn').addEventListener('click', async ()=>{
        const title = titleInput.value.trim();
        // ensure orders
        slideList.forEach((s,i)=> s.order = i);
        const payloadSlides = slideList.map(s=>({ imageUrl: s.imageUrl, caption: s.caption, ctaText: s.ctaText, ctaUrl: s.ctaUrl, order: s.order }));
        const showcaseTitle = (document.getElementById('c_showcase_title') && document.getElementById('c_showcase_title').value.trim()) || undefined;
        const showcaseSubtitle = (document.getElementById('c_showcase_sub') && document.getElementById('c_showcase_sub').value.trim()) || undefined;
        const showcaseFeatures = (document.getElementById('c_showcase_features') && document.getElementById('c_showcase_features').value) || undefined;
        const showcaseCtaText = (document.getElementById('c_showcase_cta') && document.getElementById('c_showcase_cta').value.trim()) || undefined;
        const res2 = await api('/admin/homepage', { method: 'POST', body: JSON.stringify({ title, bannerSlides: payloadSlides }) });
        const res = await api('/categories', { method:'POST', body: JSON.stringify({ name, description, imageUrl, bannerImageUrl, showcaseTitle, showcaseSubtitle, showcaseFeatures, showcaseCtaText }) });
        if (!res.ok) return document.getElementById('c_err').textContent = (res.body && res.body.error) || 'Failed';
      });
    }

    // Orders list
    async function renderOrders() {
      pageTitle.textContent = 'Orders';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      const res = await api('/api/orders');
      if (!res.ok) { content.innerHTML = '<div class="panel">Failed to load orders</div>'; return; }
      const orders = res.body || [];
      if (orders.length === 0) {
        content.innerHTML = '<div class="panel"><h3>Orders</h3><p class="muted">No orders yet.</p></div>';
        return;
      }
      let html = '<div class="panel"><h3>Orders</h3>';
      html += '<table><thead><tr><th>Order ID</th><th>Product Code</th><th>Customer Name</th><th>Email</th><th>Phone</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead><tbody>';
      orders.forEach(o => {
        const date = new Date(o.createdAt).toLocaleDateString();
        const statusColor = o.status === 'completed' ? '#22863a' : o.status === 'processing' ? '#0366d6' : o.status === 'cancelled' ? '#cb2431' : '#6a737d';
        html += `<tr><td><code style="background:#f6f8fa;padding:2px 4px;border-radius:3px;font-size:11px">${escapeHtml(o._id.substring(0,12))}</code></td><td><code style="background:#fff4ed;padding:2px 6px;border-radius:3px;font-size:12px">${escapeHtml(o.productCode||'')}</code></td><td>${escapeHtml(o.customerName||'')}</td><td>${escapeHtml(o.customerEmail||'')}</td><td>${escapeHtml(o.customerPhone||'')}</td><td><span style="display:inline-block;padding:2px 8px;border-radius:12px;background:#f0f0f0;font-size:12px;color:${statusColor};font-weight:bold">${escapeHtml(o.status||'pending')}</span></td><td class="muted" style="font-size:13px">${date}</td><td class="actions"><button data-id="${o._id}" class="btn" data-action="view-order">View</button></td></tr>`;
      });
      html += '</tbody></table></div>';
      content.innerHTML = html;
      content.querySelectorAll('[data-action="view-order"]').forEach(b => b.addEventListener('click', (e)=>{ const id = e.target.getAttribute('data-id'); renderOrderDetail(id); }));
    }

    // Order detail
    async function renderOrderDetail(id) {
      pageTitle.textContent = 'Order Details';
      content.innerHTML = '<div class="panel"><h3>Loading...</h3></div>';
      const res = await api('/api/orders/' + id);
      if (!res.ok) { content.innerHTML = '<div class="panel">Order not found</div>'; return; }
      const o = res.body;
      const date = new Date(o.createdAt).toLocaleString();
      let html = `<div class="panel" style="margin-bottom:16px"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px"><h3>Order <code style="background:#f6f8fa;padding:2px 6px;border-radius:3px;font-size:13px">${escapeHtml(o._id)}</code></h3><div style="display:flex;gap:8px"><button class="btn" id="backOrdersBtn">Back to Orders</button><button class="btn danger" id="deleteOrderBtn" title="Delete order and all associated files">Delete Order</button></div></div><div class="grid"><div class="card"><strong>${escapeHtml(o.customerName||'')}</strong><div class="small muted">${escapeHtml(o.customerEmail||'')}</div><div class="small muted">${escapeHtml(o.customerPhone||'')}</div></div><div class="card"><strong>${escapeHtml(o.status||'pending')}</strong><div class="small muted">Status</div></div><div class="card"><strong>${date}</strong><div class="small muted">Order Date</div></div></div></div>`;
      html += `<div class="panel" style="margin-bottom:16px"><h4>Shipping Address</h4><p style="margin:0;line-height:1.6">${escapeHtml((o.address && o.address.street) || '')}<br/>${escapeHtml((o.address && o.address.city) || '')}, ${escapeHtml((o.address && o.address.state) || '')} ${escapeHtml((o.address && o.address.zip) || '')}</p></div>`;
      html += `<div class="panel" style="margin-bottom:16px"><h4>Product Information</h4><p><strong>Product Name:</strong> ${escapeHtml(o.productName||'Custom T-Shirt')}</p><p><strong>Product Code:</strong> <code style="background:#f0f0f0;padding:4px 8px;border-radius:3px;font-family:monospace;font-weight:bold">${escapeHtml(o.productCode||'N/A')}</code></p><p><strong>Price:</strong> $${Number(o.productPrice||0).toFixed(2)}</p><p><strong>Quantity:</strong> ${o.quantity||1}</p></div>`;
      html += `<div class="panel" style="margin-bottom:16px"><h4>Design Details</h4><p><strong>Template:</strong> ${escapeHtml(o.designTemplate||'')}</p>`;
      
      // Images with download buttons
      if (o.originalImagePath || o.previewImagePath || o.uploadedImageData) {
        html += `<div style="margin-top:12px"><div style="display:flex;gap:16px;flex-wrap:wrap">`;
        if (o.originalImagePath) html += `<div style="display:flex;flex-direction:column;align-items:center;gap:8px"><div><p style="margin:0;font-size:12px;font-weight:bold;margin-bottom:4px"><strong>Original Design</strong></p><img src="${o.originalImagePath}" style="max-width:150px;height:150px;border-radius:6px;border:1px solid #eee;object-fit:cover"/></div><button class="btn" style="font-size:12px;padding:6px 10px" onclick="downloadProtectedFile('${id}','original')" title="Download original image">⬇️ Download</button></div>`;
        if (o.previewImagePath) html += `<div style="display:flex;flex-direction:column;align-items:center;gap:8px"><div><p style="margin:0;font-size:12px;font-weight:bold;margin-bottom:4px"><strong>Preview</strong></p><img src="${o.previewImagePath}" style="max-width:150px;height:150px;border-radius:6px;border:1px solid #eee;object-fit:cover"/></div><button class="btn" style="font-size:12px;padding:6px 10px" onclick="downloadProtectedFile('${id}','preview')" title="Download preview image">⬇️ Download</button></div>`;
        if (o.uploadedImageData) html += `<div style="display:flex;flex-direction:column;align-items:center;gap:8px"><div><p style="margin:0;font-size:12px;font-weight:bold;margin-bottom:4px"><strong>Customer Upload</strong></p><img src="${o.uploadedImageData}" style="max-width:150px;height:150px;border-radius:6px;border:1px solid #eee;object-fit:cover"/></div><button class="btn" style="font-size:12px;padding:6px 10px" onclick="downloadProtectedFile('${id}','uploaded')" title="Download customer upload">⬇️ Download</button></div>`;
        html += `</div></div>`;
      }
      
      html += `</div>`;
      html += `<div class="panel"><h4>Update Status</h4><div style="display:flex;gap:8px;align-items:center"><select id="statusSelect" style="flex:1;max-width:200px"><option value="pending" ${o.status==='pending'?'selected':''}> Pending</option><option value="processing" ${o.status==='processing'?'selected':''}> Processing</option><option value="completed" ${o.status==='completed'?'selected':''}> Completed</option><option value="cancelled" ${o.status==='cancelled'?'selected':''}> Cancelled</option></select><button class="btn primary" id="updateStatusBtn">Update</button></div></div>`;
      content.innerHTML = html;
      document.getElementById('backOrdersBtn').addEventListener('click', () => renderOrders());
      document.getElementById('deleteOrderBtn').addEventListener('click', async () => {
        if (!confirm('Are you sure you want to delete this order?\n\nThis will:\n- Delete the order from database\n- Remove all associated images (Original, Preview, Upload)\n\nThis action cannot be undone.')) return;
        try {
          const token = localStorage.getItem(tokenKey);
          const deleteRes = await fetch('/api/orders/' + id, { 
            method: 'DELETE',
            headers: { 'Authorization': 'Bearer ' + token }
          });
          const result = await deleteRes.json();
          if (!deleteRes.ok) return alert((result && result.error) || 'Failed to delete');
          alert('Order deleted successfully!\n' + result.filesDeleted + ' files were removed.');
          renderOrders();
        } catch (err) {
          alert('Error deleting order: ' + err.message);
        }
      });
      document.getElementById('updateStatusBtn').addEventListener('click', async () => {
        const newStatus = document.getElementById('statusSelect').value;
        const updateRes = await api('/api/orders/' + id, { method: 'PUT', body: JSON.stringify({ status: newStatus }) });
        if (!updateRes.ok) return alert((updateRes.body && updateRes.body.error) || 'Failed to update');
        alert('Order status updated!');
        renderOrderDetail(id);
      });
    }

    // Helpers
    function escapeHtml(str){ return String(str||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') }

    // initialize
    (async function(){
      // Show simple user info decoded from token
      try{
        const payload = JSON.parse(atob(localStorage.getItem(tokenKey).split('.')[1]));
        document.getElementById('userInfo').textContent = payload.email || '';
        // verify token by calling a protected endpoint
        const ok = await api('/admin/stats');
        if (!ok.ok) { localStorage.removeItem(tokenKey); window.location.href = '/login'; }
      }catch(e){ localStorage.removeItem(tokenKey); window.location.href = '/login'; }
      // Default navigate based on URL
      if (location.pathname === '/admin' || location.pathname === '/admin/') navigate('/admin/dashboard', true);
      else renderRoute();
    })();
  </script>
</body>
</html>