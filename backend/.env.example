# Server
NODE_ENV=development
PORT=5000

# MongoDB (REQUIRED). There is no localhost fallback.
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=
# Optional: overrides the database name found in MONGODB_URI
MONGODB_DB_NAME=adviprints

# Auth (REQUIRED in production, at least 32 random characters: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_EXPIRES_IN=1h
# Comma-separated e-mails that always receive the admin role at login (use to bootstrap the first admin)
ADMIN_EMAILS=

# CORS (REQUIRED in production): comma-separated frontend origins, no trailing slash
CORS_ORIGINS=http://localhost:3000

# Image storage. Production must use Cloudinary; "local" is for development only.
STORAGE_DRIVER=local
# Either the single URL...
CLOUDINARY_URL=
# ...or the three parts
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: root folder inside Cloudinary
CLOUDINARY_FOLDER=adviprints
# Optional: where legacy/local-development uploads live (default: backend/public/uploads)
UPLOADS_DIR=
